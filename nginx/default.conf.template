# La imagen de nginx procesa este template con envsubst al arrancar: ${API_UPSTREAM} sale del
# entorno del contenedor, el resto de variables ($uri, $host...) las resuelve nginx.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API: hoy el auth-server, mañana el api-gateway. Mismo origen que la app, así que no hay CORS.
    location /api/v1/ {
        proxy_pass ${API_UPSTREAM}/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Los assets del build llevan hash en el nombre: se pueden cachear para siempre.
    location /assets/ {
        add_header Cache-Control "public, immutable, max-age=31536000";
        try_files $uri =404;
    }

    # El index no se cachea: es lo que apunta al bundle nuevo después de cada despliegue.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA: cualquier ruta desconocida la resuelve React Router, no nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
